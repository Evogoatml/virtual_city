# Virtual City — environment template
# Copy to .env and fill in values you need.

# Optional: protect mutating API routes (POST /api/query, meeting, plan, budget, webcheck)
CITY_API_KEY=

# Content Creation (Venice AI)
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=zai-org-glm-5-2

# --- Agent Runtime LLM (OpenAI-compatible) ---
# Any free provider from awesome-free-llm-apis works by swapping these three vars.
# Groq is a fast, generous free default (see https://github.com/mnfst/awesome-free-llm-apis).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# LLM_MOCK=1   # uncomment for offline (no key); runtime runs read/default skills only

# Content Automation video providers (any subset)
KLING_API_KEY=
PIKA_API_KEY=
RUNWAY_API_KEY=
HEYGEN_API_KEY=

# Optional analytics / viral
OPENAI_API_KEY=
GEMINI_API_KEY=

# Shopify Store (Effata Picks — print-on-demand apparel)
SHOPIFY_STORE_DOMAIN=effataprints.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
# Public base URL Shopify webhooks POST to (e.g. https://yourcity.com or ngrok https://xxxx.ngrok.io)
SHOPIFY_WEBHOOK_BASE_URL=
SHOPIFY_API_VERSION=2026-01


# Shopify agent autonomy
# Set to 1 to let the agent auto-approve destructive actions (discounts,
# inventory adjusts). Leave unset to require manual approve <id> in the console.
SHOPIFY_AUTO_APPROVE=

# Optional external web-check checkout
WEB_CHECK_PATH=
WEBCHECK_PORT=3000
WEBCHECK_HOST=127.0.0.1

# Bind host for local production (default 127.0.0.1 when CITY_API_KEY unset)
# CITY_HOST=0.0.0.0
CITY_PORT=5000
